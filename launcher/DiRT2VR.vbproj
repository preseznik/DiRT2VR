<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiRT2VR</RootNamespace>
    <StartupObject>DiRT2VR.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DiRT2VR</AssemblyName>
    <Version>0.12.2</Version>
    <BuildUtc Condition="'$(BuildUtc)' == ''">Development build</BuildUtc>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\DiRT2VR.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildUtc" Value="$(BuildUtc)" />
    <EmbeddedResource Include="assets\DiRT2VR.ico" LogicalName="DiRT2VR.ico" />
    <EmbeddedResource Include="assets\race-catalog.json" LogicalName="DiRT2VR.race-catalog.json" />
    <Import Include="System.IO" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Threading" />
    <Import Include="System.Runtime.InteropServices" />
    <ProjectReference Include="../tools/ego-xml/EgoXml.csproj" />
  </ItemGroup>
</Project>
